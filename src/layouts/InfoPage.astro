---
import About from "../components/About.astro";
import Press from "../components/Press.astro";
import type { InfoPage } from "../content/pages.ts";
import { withBase } from "../lib/paths.ts";
import Base from "./Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

interface Props {
  page: InfoPage;
}
const { page } = Astro.props;
---
<Base page={page}>
  <div class="mx-auto max-w-[46rem] px-4 pt-6 pb-2 sm:px-6 sm:pt-10">
    <Breadcrumbs page={page} />
    <h1 class="text-[length:var(--type-heading)] leading-[1.15] font-semibold tracking-[var(--type-heading-tracking)] sm:text-[length:var(--type-heading-wide)]">{page.h1}</h1>
    <p class="mt-3 max-w-[62ch] text-[1.0625rem] leading-relaxed text-muted-foreground sm:text-lg" set:html={withBase(page.intro)} />
  </div>
  <div class="prose-kn mx-auto max-w-[46rem] px-4 sm:px-6">
    {page.body === "about" ? <About lang={page.lang ?? "en"} /> : <Press lang={page.lang ?? "en"} />}
  </div>
</Base>
