---
import { ICONS, type IconName } from "../icons/icons.ts";

interface Props {
  name: IconName;
  /** The filled state: the icon's area takes a soft tint of the current color. */
  filled?: boolean;
  class?: string;
}
const { name, filled = false, class: className } = Astro.props;
const icon: { d: string; fill?: string } = ICONS[name];
---
<svg class:list={["icon", className]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {filled && icon.fill && <path class="icon-fill" d={icon.fill} fill="currentColor" stroke="none" />}
  <path d={icon.d} />
</svg>

<style is:global>
  .icon .icon-fill {
    fill-opacity: 0.18;
  }
</style>
