---
import { BRAND as ALL } from "../content/brand.ts";
import type { Lang } from "../i18n/core.ts";
import { SITE_STRINGS } from "../i18n/site.ts";
import { withBase } from "../lib/paths.ts";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const BRAND = ALL[lang];
---
{BRAND.sections.map((s) => (
  <section>
    <h2>{s.heading}</h2>
    <ul class="brand-list">
      {s.items.map((i) => <li set:html={withBase(i)} />)}
    </ul>
  </section>
))}

<section aria-labelledby="owner">
  <h2 id="owner">{SITE_STRINGS[lang].brand.owner}</h2>
  <p>{BRAND.owner}</p>
  <p set:html={BRAND.removal} />
</section>

<style>
  .brand-list {
    display: grid;
    gap: 0.75rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
</style>
