---
import Editor from "../components/Editor.astro";
import { EDITOR_STRINGS } from "../i18n/editor.ts";
import Illustration from "../components/Illustration.astro";
import { illustrationFor } from "../lib/illustrations.ts";
import LetterChart from "../components/LetterChart.astro";
import WordTable from "../components/WordTable.astro";
import Faq from "../components/Faq.astro";
import type { ToolPage } from "../content/pages.ts";
import { TAGLINE } from "../content/story.ts";
import { isHome } from "../content/pages.ts";
import { withBase } from "../lib/paths.ts";
import Base from "./Base.astro";
import PageTop from "../components/PageTop.astro";

interface Props {
  page: ToolPage;
}
const { page } = Astro.props;
const illo = illustrationFor(page);
---
<Base page={page}>
  <div class="hero mx-auto max-w-[54rem] px-4 pt-6 pb-8 sm:px-6 sm:pt-10 md:pb-10">
    <div>
    <PageTop page={page} />
    <h1 class="text-[length:var(--type-heading)] leading-[1.15] font-semibold tracking-[var(--type-heading-tracking)] sm:text-[length:var(--type-heading-wide)]">{page.h1}</h1>
    <p class="mt-3 max-w-[62ch] text-[1.0625rem] leading-relaxed text-muted-foreground sm:text-lg" set:html={withBase(page.intro)} />
    {isHome(page) && <p class="tagline mt-4 text-[1.0625rem] font-semibold text-primary sm:text-lg">{TAGLINE[page.lang ?? "en"]}</p>}
    </div>
    {illo && <Illustration {...illo} class="hero-illo" />}
  </div>
  <Editor mode={page.mode} welcome={page.welcome} strings={EDITOR_STRINGS[page.lang ?? "en"]} lang={page.lang ?? "en"} />
  <div class="prose-kn mx-auto max-w-[46rem] px-4 sm:px-6">
    <section aria-labelledby="how-heading">
      <h2 id="how-heading">{page.howTitle}</h2>
      <ol class="steps">
        {page.steps.map((s) => <li><span set:html={withBase(s)} /></li>)}
      </ol>
    </section>
    {page.chart === "letters" && <LetterChart />}
    {page.chart === "words" && <WordTable />}
    <Faq faq={page.faq} lang={page.lang ?? "en"} />
  </div>
</Base>

<style>
  .steps {
    counter-reset: step;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
  }
  .steps li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 9999px;
    background: var(--accent);
    color: var(--accent-foreground);
    font-size: 0.875rem;
    font-weight: 600;
  }
</style>
