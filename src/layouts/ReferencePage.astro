---
import AlphabetTables from "../components/AlphabetTables.astro";
import Illustration from "../components/Illustration.astro";
import KagunitaTable from "../components/KagunitaTable.astro";
import type { ReferencePage } from "../content/pages.ts";
import { illustrationFor } from "../lib/illustrations.ts";
import { withBase } from "../lib/paths.ts";
import Base from "./Base.astro";
import PageTop from "../components/PageTop.astro";
import Faq from "../components/Faq.astro";

interface Props {
  page: ReferencePage;
}
const { page } = Astro.props;
const illo = illustrationFor(page);
---
<Base page={page}>
  <div class="hero hero-reference mx-auto max-w-[54rem] px-4 pt-6 pb-2 sm:px-6 sm:pt-10">
    <div>
    <PageTop page={page} />
    <h1 class="text-[length:var(--type-heading)] leading-[1.15] font-semibold tracking-[var(--type-heading-tracking)] sm:text-[length:var(--type-heading-wide)]">{page.h1}</h1>
    <p class="mt-3 max-w-[62ch] text-[1.0625rem] leading-relaxed text-muted-foreground sm:text-lg" set:html={withBase(page.intro)} />
    </div>
    {illo && <Illustration {...illo} class="hero-illo" />}
  </div>
  <div class="prose-kn mx-auto max-w-[54rem] px-4 sm:px-6">
    {page.table === "alphabet" && <AlphabetTables />}
    {page.table === "kagunita" && <KagunitaTable />}
    <Faq faq={page.faq} lang={page.lang ?? "en"} />
  </div>
</Base>
