---
import type { RatioTable } from "../content/pages.ts";
import { fmt, type Lang } from "../i18n/core.ts";
import { SITE_STRINGS } from "../i18n/site.ts";

interface Props {
  table: RatioTable;
  lang: Lang;
}
const { table, lang } = Astro.props;
const T = SITE_STRINGS[lang].project;
const top = Math.max(...table.rows.map((r) => r.high));
const n = (x: number) => x.toFixed(2);
---
<div class="ratio-wrap">
  <table class="ratios">
    <thead>
      <tr>
        <th scope="col">{T.name}</th>
        <th scope="col">{T.ratio}</th>
        <th scope="col">{T.interval}</th>
      </tr>
    </thead>
    <tbody>
      {table.rows.map((r) => (
        <tr>
          <th scope="row">{r.name}</th>
          <td>
            <span class="ratio-value">{n(r.ratio)}</span>
            <svg class="ratio-bar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true" focusable="false">
              <rect class="ratio-track" width="100" height="8" />
              <rect class="ratio-fill" width={(r.ratio / top) * 100} height="8" />
            </svg>
          </td>
          <td class="ratio-range">{fmt(T.range, { low: n(r.low), high: n(r.high) })}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .ratio-wrap {
    overflow-x: auto;
    margin: 1.25rem 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--card);
  }
  .ratios {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  .ratios th,
  .ratios td {
    padding: 0.625rem 1rem;
    text-align: left;
    vertical-align: middle;
  }
  .ratios thead th {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--muted-foreground);
    border-bottom: 1px solid var(--border);
  }
  .ratios tbody tr + tr > * {
    border-top: 1px solid var(--border);
  }
  .ratios tbody th {
    font-weight: 600;
    white-space: nowrap;
  }
  .ratio-value {
    display: block;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }
  .ratio-bar {
    display: block;
    width: 100%;
    min-width: 4rem;
    height: 0.375rem;
    margin-top: 0.25rem;
    border-radius: 9999px;
    overflow: hidden;
  }
  .ratio-track {
    fill: var(--muted);
  }
  .ratio-fill {
    fill: var(--primary);
  }
  .ratio-range {
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
