---
import { PRESS } from "../content/press.ts";
import { STORY as STORIES, TAGLINE as TAGLINES } from "../content/story.ts";
import { fmt, type Lang } from "../i18n/core.ts";
import { SITE_STRINGS } from "../i18n/site.ts";
import { href } from "../lib/paths.ts";

import Icon from "./Icon.astro";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { bios: BIOS, colors: COLORS, contact: CONTACT, descriptions: DESCRIPTIONS, facts: FACTS, logos: LOGOS, photos: PHOTOS, screenshots: SCREENSHOTS } = PRESS[lang];
const STORY = STORIES[lang];
const TAGLINE = TAGLINES[lang];
const T = SITE_STRINGS[lang].press;
---
<section aria-labelledby="story">
  <h2 id="story" class="icon-heading"><Icon name="book" filled class="size-6 text-primary" />{T.story}</h2>
  <p class="press-tagline">{TAGLINE}</p>
  {STORY.map((p) => <p set:html={p} />)}
</section>

<section aria-labelledby="logos">
  <h2 id="logos" class="icon-heading"><Icon name="image" filled class="size-6 text-primary" />{T.logos}</h2>
  <p>{T.logosIntro}</p>
  <div class="logos">
    {LOGOS.map((l) => (
      <figure class="logo-card">
        <div class="logo-preview light"><img src={href(`/brand/${l.mark}-wordmark-light.svg`)} alt={fmt(T.logoLight, { name: l.name })} width={l.width} height="48" /></div>
        <div class="logo-preview dark"><img src={href(`/brand/${l.mark}-wordmark-dark.svg`)} alt={fmt(T.logoDark, { name: l.name })} width={l.width} height="48" /></div>
        <figcaption>
          <b>{l.name}</b>
          <ul class="files" role="list">
            {l.files.map((f) => <li><a class="file-link" href={href(`/brand/${l.mark}-${f}`)} download><Icon name="save" class="size-4" /><span class="sr-only">{l.name} </span>{f}</a></li>)}
          </ul>
        </figcaption>
      </figure>
    ))}
  </div>
  <p set:html={fmt(T.logosNote, { names: `<a href="${href(lang === "kn" ? "/kn/brand/" : "/brand/")}">${T.namesPage}</a>` })} />
</section>

<section aria-labelledby="colors">
  <h2 id="colors" class="icon-heading"><Icon name="palette" filled class="size-6 text-primary" />{T.colors}</h2>
  <ul class="colors" role="list">
    {COLORS.map((c) => (
      <li>
        <svg viewBox="0 0 40 40" width="40" height="40" aria-hidden="true"><rect width="40" height="40" rx="10" fill={c.hex} /></svg>
        <span><b>{c.name}</b> <code>{c.hex}</code><br /><span class="text-muted-foreground">{c.use}</span></span>
      </li>
    ))}
  </ul>
</section>

<section aria-labelledby="descriptions">
  <h2 id="descriptions" class="icon-heading"><Icon name="quote" filled class="size-6 text-primary" />{T.descriptions}</h2>
  {DESCRIPTIONS.map((d) => (
    <>
      <h3>{fmt(T.inWords, { n: d.words })}</h3>
      <p>{d.text}</p>
    </>
  ))}
</section>

<section aria-labelledby="people">
  <h2 id="people" class="icon-heading"><Icon name="people" filled class="size-6 text-primary" />{T.people}</h2>
  <div class="bios">
    {BIOS.map((b, i) => (
      <article class="bio">
        <div class="photo"><mark class="todo">{fmt(T.photo, { name: PHOTOS[i] ?? "" })}</mark></div>
        <h3>{b.name}</h3>
        <p class="text-muted-foreground">{b.role}</p>
        <p set:html={b.text} />
        <p><a href={b.source}>{new URL(b.source).host}</a></p>
      </article>
    ))}
  </div>
</section>

<section aria-labelledby="screenshots">
  <h2 id="screenshots" class="icon-heading"><Icon name="image" filled class="size-6 text-primary" />{T.screenshots}</h2>
  <div class="shots">
    {SCREENSHOTS.map((s) => (
      <a href={href(`/press/${s.file}`)} download>
        <span class="sr-only">{T.download} </span><img src={href(`/press/${s.file}`)} alt={s.alt} width={s.width} height={s.height} loading="lazy" decoding="async" />
      </a>
    ))}
  </div>
</section>

<section aria-labelledby="facts">
  <h2 id="facts" class="icon-heading"><Icon name="info" filled class="size-6 text-primary" />{T.facts}</h2>
  <ul class="facts">
    {FACTS.map((f) => <li>{f.fact} <a href={f.source.startsWith("/") ? href(f.source) : f.source}>{f.label}</a></li>)}
  </ul>
</section>

<section aria-labelledby="contact">
  <h2 id="contact" class="icon-heading"><Icon name="mail" filled class="size-6 text-primary" />{T.contact}</h2>
  <p set:html={CONTACT} />
</section>

<style>
  .icon-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .file-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .press-tagline {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--primary);
  }
  .logos, .bios {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 40rem) {
    .logos, .bios { grid-template-columns: 1fr 1fr; }
  }
  .logo-card {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--card);
  }
  .logo-preview {
    display: grid;
    place-items: center;
    padding: 1.5rem 1rem;
  }
  .logo-preview img { height: 3rem; width: auto; max-width: 100%; }
  .logo-preview.light { background: #f3f6fa; }
  .logo-preview.dark { background: #0c0e15; }
  .logo-card figcaption { padding: 1rem; }
  .files {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.5rem;
    font-size: 0.9375rem;
  }
  .colors {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 40rem) {
    .colors { grid-template-columns: 1fr 1fr; }
  }
  .colors li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .colors svg { flex: none; outline: 1px solid var(--border); border-radius: 10px; }
  .bio .photo {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    padding: 1rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius-xl);
    text-align: center;
  }
  .bio h3 { margin-bottom: 0; }
  .bio h3 + p { margin-top: 0; }
  .shots {
    display: grid;
    gap: 1rem;
    align-items: start;
  }
  @media (min-width: 40rem) {
    .shots { grid-template-columns: 3fr 1fr; }
  }
  .shots img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
  }
  .facts {
    display: grid;
    gap: 0.75rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
</style>
