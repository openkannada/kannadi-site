---
import type { TypingMode } from "../editor/text.ts";
import { fmt, parts, pick } from "../editor/strings.ts";
import type { Lang } from "../i18n/core.ts";
import { EDITOR_EN, type EditorStrings } from "../i18n/editor.en.ts";
import "../styles/editor.css";

import Icon from "./Icon.astro";

interface Props {
  mode: TypingMode;
  welcome: string;
  strings?: EditorStrings;
  /** The page's language, for the plural forms of the counts. */
  lang?: Lang;
}
const { mode, welcome, strings: t = EDITOR_EN, lang = "en" } = Astro.props;
const modes: { value: TypingMode; lang?: string; wide?: boolean }[] = [
  { value: "kannada", lang: "kn" },
  { value: "english" },
  { value: "baraha" },
  { value: "iso15919", wide: true },
];
// Key names stay as printed on the keys in every language.
const MODE_KEYS: Record<string, string> = { alt: "Alt", first: "1", last: "4" };
const MAC_KEYS: Record<string, string> = { cmd: "⌘", ctrl: "Ctrl", option: "Option", alt: "Alt" };
const counts = [
  { id: "count-aksharas", forms: t.counts.aksharas },
  { id: "count-words", forms: t.counts.words },
  { id: "count-chars", forms: t.counts.characters, narrow: "hidden sm:inline" },
];
---
<section class="editor" aria-label={t.editor.label} data-md-skip data-default-mode={mode} data-ui-strings={t === EDITOR_EN ? undefined : JSON.stringify(t)}>
  <div class="dock">
    <div class="toolbar glass" role="group" aria-label={t.toolbar.label}>
      <fieldset class="seg" aria-describedby="mode-help">
        <legend class="sr-only">{t.toolbar.typeWith}</legend>
        {modes.map((m) => (
          <>
            <input type="radio" name="mode" id={`mode-${m.value}`} value={m.value} checked={m.value === mode} autocomplete="off" class:list={[m.wide && "wide-only"]} />
            <label for={`mode-${m.value}`} title={fmt(t.toolbar.typeWithMode, { name: t.modes[m.value].name })} lang={m.lang}>
              {t.modes[m.value].label}
              {m.value === "kannada" && <span class="sr-only" lang={lang}>{t.modes.kannada.spoken}</span>}
            </label>
          </>
        ))}
      </fieldset>
      <p id="mode-help" class="sr-only">{t.toolbar.modeHelp}</p>
      <span class="divider" aria-hidden="true"></span>
      <button type="button" class="btn hidden sm:inline-flex" id="open" title={t.toolbar.openTitle}>
        <Icon name="open" /><span class="label">{t.toolbar.open}</span>
      </button>
      <input type="file" id="file" class="sr-only" tabindex="-1" aria-hidden="true" accept=".txt,.docx,.html,.htm,text/plain,text/html,application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
      <button type="button" class="btn hidden sm:inline-flex" id="convert" title={t.toolbar.convertTitle}>
        <Icon name="convert" /><span class="label">{t.toolbar.convert}</span>
      </button>
      <button type="button" class="btn btn-icon mic" id="voice" aria-pressed="false" aria-label={t.toolbar.voice} title={t.toolbar.voice} hidden>
        <Icon name="mic" />
      </button>
      <button type="button" class="btn btn-icon" popovertarget="tools-menu" aria-label={t.toolbar.more} title={t.toolbar.more}>
        <Icon name="tools" />
      </button>
      <button type="button" class="chip" id="problems" popovertarget="problems-panel" hidden>
        <span class="chip-dot" aria-hidden="true"></span>
        <span id="problem-count">0</span>
        <span class="chip-words">{t.problems.chip}</span>
      </button>
      <button type="button" class="btn btn-primary" popovertarget="save-menu" title={t.toolbar.saveTitle}>
        <Icon name="save" /><span class="label">{t.toolbar.save}</span>
      </button>
    </div>
  </div>

  <div id="tools-menu" popover class="menu tool-menu" role="group" aria-label={t.toolbar.more}>
    <button type="button" class="menu-item sm:hidden" data-run="open">{t.menu.openFile}</button>
    <button type="button" class="menu-item sm:hidden" data-run="convert">{t.menu.convertFrom}</button>
    <button type="button" class="menu-item sm:hidden" data-run="iso">{t.menu.typeIso}</button>
    <button type="button" class="menu-item" data-run="normalize">{t.menu.normalize} <small>{t.menu.normalizeNote}</small></button>
    <button type="button" class="menu-item" data-run="modernize">{t.menu.modernize} <small lang="kn">{t.menu.modernizeNote}</small></button>
    <button type="button" class="menu-item" data-run="new">{t.menu.newDocument}</button>
    <div class="menu-sep" role="separator"></div>
    <fieldset class="menu-row">
      <legend class="menu-label">{t.menu.typeface}</legend>
      <div class="seg seg-small">
        <input type="radio" name="font" id="font-sans" value="sans" checked /><label for="font-sans">{t.menu.sans}</label>
        <input type="radio" name="font" id="font-serif" value="serif" /><label for="font-serif">{t.menu.serif}</label>
      </div>
    </fieldset>
    <div class="menu-sep" role="separator"></div>
    <p class="menu-label">{t.menu.whenConverting}</p>
    <label class="menu-check"><input type="checkbox" id="auto-convert" checked /> {t.menu.autoConvert}</label>
    <label class="menu-check"><input type="checkbox" id="zero" checked /> <span>{parts(t.menu.zero).map((p) => ("slot" in p ? <span lang="kn">{p.slot === "from" ? t.menu.zeroFrom : t.menu.zeroTo}</span> : p.text))}</span></label>
    <label class="menu-check"><input type="checkbox" id="digits" /> {t.menu.digits}</label>
    <div class="menu-sep hidden md:block" role="separator"></div>
    <button type="button" class="menu-item hidden md:flex" data-run="shortcuts">{t.menu.shortcuts} <small data-shortcut>Ctrl /</small></button>
  </div>

  <div id="save-menu" popover class="menu save-menu" role="group" aria-label={t.save.label}>
    <button type="button" class="menu-item" data-export="docx">{t.save.docx} <small>.docx</small></button>
    <button type="button" class="menu-item" data-export="txt">{t.save.txt} <small>.txt</small></button>
    <button type="button" class="menu-item" data-export="html">{t.save.html} <small>.html</small></button>
    <button type="button" class="menu-item" data-export="nudi">{t.save.nudi} <small>.txt</small></button>
    <div class="menu-sep" role="separator"></div>
    <button type="button" class="menu-item" data-run="copy">{t.save.copy}</button>
    <button type="button" class="menu-item" data-run="copy-nudi">{t.save.copyNudi}</button>
  </div>

  <div id="problems-panel" popover class="menu problems-panel" role="group" aria-labelledby="problems-heading">
    <p id="problems-heading" class="menu-label">{t.problems.heading}</p>
    <ol id="problem-list" class="problem-list"></ol>
    <p id="problem-more" class="menu-note" hidden></p>
    <p class="menu-note hidden md:block">{parts(t.problems.nextKey).map((p) => ("slot" in p ? <kbd>F8</kbd> : p.text))}</p>
  </div>

  <div id="suggest" class="suggest glass lift" role="group" aria-label={t.editor.suggestions} hidden></div>

  <div class="sheet" id="sheet">
    <div id="doc" class="doc" role="textbox" aria-multiline="true" aria-label={t.editor.document} aria-describedby="welcome" lang="kn" spellcheck="false" autocapitalize="off" translate="no"></div>
    <div id="welcome" class="welcome">
      <p set:html={welcome} />
      {mode === "kannada" && <button type="button" id="sample" class="sample">{t.editor.sample}</button>}
    </div>
    <div class="sheet-foot" role="group" aria-label={t.editor.status}>
      {counts.map((c) => (
        <span class={c.narrow}>{parts(pick(0, c.forms, lang)).map((p) => ("slot" in p ? <b id={c.id}>0</b> : p.text))}</span>
      ))}
      <span id="saved" class="saved"></span>
    </div>
    <p class="drop-hint" aria-hidden="true">{t.editor.dropHint}</p>
  </div>

  <p id="announce" class="sr-only" role="status" aria-live="polite"></p>
  <p id="heard" class="heard glass lift" lang="kn" hidden></p>
  <div id="toast" class="toast glass lift" hidden>
    <p id="toast-text"></p>
    <button type="button" id="toast-action" class="toast-action" hidden></button>
  </div>

  <div id="popover" class="fix glass lift" role="dialog" aria-label={t.fix.dialog} hidden></div>

  <dialog id="shortcuts" class="glass shortcuts" aria-labelledby="shortcuts-heading">
    <form method="dialog">
      <div class="flex items-center justify-between gap-4">
        <h2 id="shortcuts-heading" class="text-lg font-semibold">{t.shortcuts.heading}</h2>
        <button type="submit" class="btn btn-icon" aria-label={t.shortcuts.close}><Icon name="close" /></button>
      </div>
      <dl class="keys">
        <dt><kbd>Ctrl</kbd> <kbd>O</kbd></dt><dd>{t.shortcuts.open}</dd>
        <dt><kbd>Ctrl</kbd> <kbd>S</kbd></dt><dd>{t.shortcuts.save}</dd>
        <dt><kbd>Ctrl</kbd> <kbd>Z</kbd></dt><dd>{t.shortcuts.undo}</dd>
        <dt><kbd>F8</kbd></dt><dd>{t.shortcuts.next}</dd>
        <dt><kbd>Shift</kbd> <kbd>F8</kbd></dt><dd>{t.shortcuts.previous}</dd>
        <dt>{parts(t.shortcuts.modesKeys).map((p) => ("slot" in p ? <kbd>{MODE_KEYS[p.slot]}</kbd> : p.text))}</dt><dd>{t.shortcuts.modes}</dd>
        <dt><kbd>Tab</kbd></dt><dd>{t.shortcuts.nextWord}</dd>
        <dt><kbd>Esc</kbd></dt><dd>{t.shortcuts.keepWord}</dd>
        <dt><kbd>Ctrl</kbd> <kbd>/</kbd></dt><dd>{t.shortcuts.list}</dd>
      </dl>
      <p class="text-sm text-muted-foreground">{parts(t.shortcuts.mac).map((p) => ("slot" in p ? <kbd>{MAC_KEYS[p.slot]}</kbd> : p.text))}</p>
    </form>
  </dialog>
</section>

<script>
  import "../editor/main.ts";
</script>
