---
import About from "../components/About.astro";
import Brand from "../components/Brand.astro";
import Contribute from "../components/Contribute.astro";
import Press from "../components/Press.astro";
import type { InfoPage } from "../content/pages.ts";
import Base from "./Base.astro";
import PageHero from "../components/PageHero.astro";

interface Props {
  page: InfoPage;
}
const { page } = Astro.props;
// About has cards, photos and a pull-out, so it takes the column; the other info pages are 1 line of prose wide.
const WIDTH = { about: "column", contribute: "prose", press: "prose", brand: "prose" } as const;
const width = WIDTH[page.body];
---
<Base page={page}>
  <PageHero page={page} width={width} />
  <div class={`wrap-${width}`}><div class="prose-kn">
    {page.body === "about" && <About lang={page.lang ?? "en"} />}
    {page.body === "brand" && <Brand lang={page.lang ?? "en"} />}
    {page.body === "press" && <Press lang={page.lang ?? "en"} />}
    {page.body === "contribute" && <Contribute lang={page.lang ?? "en"} />}
  </div></div>
</Base>
