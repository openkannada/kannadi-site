---
import { PAGES } from "../content/pages.ts";
import { AUTHOR, ORG, SITE } from "../content/site.ts";
import { href } from "../lib/paths.ts";
import Logo from "./Logo.astro";
---
<footer class="mx-auto mt-20 w-full max-w-6xl px-4 pb-[max(2rem,calc(env(safe-area-inset-bottom)+6rem))] text-sm text-muted-foreground sm:px-6 md:pb-10">
  <div class="flex flex-col gap-6 border-t border-border pt-8 md:flex-row md:items-start md:justify-between">
    <div class="max-w-md space-y-2">
      <p class="flex items-center gap-2.5 font-medium text-foreground">
        <Logo mark="kannadi" class="size-9" />
        <span>{SITE.name} <span lang="kn">{SITE.nameKn}</span></span>
      </p>
      <p>
        Made by <a href={AUTHOR.url}>{AUTHOR.name}</a> with the open-source{" "}
        <a href={SITE.repository}>kannadi</a> library.
      </p>
      <p>
        Started by {ORG.founders.map((f, i) => (
          <>{i > 0 && " and "}<a href={f.url}>{f.name}</a></>
        ))}. Supported by <a href={ORG.supporter.url}>{ORG.supporter.label}</a>.
      </p>
      <p>
        The licenses and names of {ORG.name} belong to the project. {ORG.supporter.label} supports it and holds none of them.{" "}
        Text and images: CC BY 4.0. Code: MIT or Apache-2.0. <a href={href("/names-and-logos/")}>Names and logos</a>.
      </p>
      <p>If kannadi helps your project, a mention or a link to <a href={AUTHOR.url}>prasad.tech</a> is appreciated.</p>
      <p>Word suggestions use a list of words counted in the articles that <a href="https://kn.wikipedia.org">Kannada Wikipedia</a> contributors write, shared under <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>.</p>
    </div>
    <nav aria-label="All pages">
      <ul class="grid grid-cols-2 gap-x-8 gap-y-1.5" role="list">
        {PAGES.map((p) => (
          <li><a class="text-muted-foreground no-underline hover:text-foreground hover:underline" href={href(p.slug ? `/${p.slug}/` : "/")}>{p.name}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</footer>
