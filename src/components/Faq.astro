---
import type { Faq } from "../content/pages.ts";
import type { Lang } from "../i18n/core.ts";
import { SITE_STRINGS } from "../i18n/site.ts";
import { withBase } from "../lib/paths.ts";

interface Props {
  faq: Faq[];
  lang?: Lang;
}
const { faq, lang = "en" } = Astro.props;
---
<section aria-labelledby="faq-heading">
  <h2 id="faq-heading">{SITE_STRINGS[lang].faq}</h2>
  <div class="faq">
    {faq.map((f) => (
      <details>
        <summary set:html={f.q} />
        <p set:html={withBase(f.a)} />
      </details>
    ))}
  </div>
</section>

<style>
  .faq {
    border-top: 1px solid var(--border);
  }
  .faq details {
    border-bottom: 1px solid var(--border);
  }
  .faq summary {
    cursor: pointer;
    list-style: none;
    padding: 1rem 2rem 1rem 0;
    position: relative;
    font-weight: 600;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: "";
    position: absolute;
    right: 0.25rem;
    top: 1.45rem;
    width: 0.55rem;
    height: 0.55rem;
    border-right: 1.75px solid var(--muted-foreground);
    border-bottom: 1.75px solid var(--muted-foreground);
    transform: rotate(45deg);
    transition: transform 0.2s var(--ease-standard);
  }
  .faq details[open] summary::after {
    transform: rotate(225deg);
    top: 1.7rem;
  }
  .faq details p {
    margin: 0 0 1.25rem;
    color: var(--muted-foreground);
  }
</style>
