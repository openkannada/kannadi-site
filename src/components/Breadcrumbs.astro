---
import { HOME, type Page } from "../content/pages.ts";
import { href } from "../lib/paths.ts";

interface Props {
  page: Page;
}
const { page } = Astro.props;
---
{page.slug && (
  <nav aria-label="Breadcrumb" class="crumbs" data-md-skip>
    <ol>
      <li><a href={href("/")}>{HOME.name}</a></li>
      <li aria-current="page">{page.name}</li>
    </ol>
  </nav>
)}

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0 0 0.75rem;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
  .crumbs li + li::before {
    content: "/" / "";
    margin-right: 0.5rem;
    opacity: 0.6;
  }
  .crumbs a {
    color: inherit;
  }
</style>
