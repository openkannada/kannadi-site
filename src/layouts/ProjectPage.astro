---
import CompareTable from "../components/CompareTable.astro";
import Icon from "../components/Icon.astro";
import PageHero from "../components/PageHero.astro";
import RatioTable from "../components/RatioTable.astro";
import type { ProjectPage } from "../content/pages.ts";
import { SITE_STRINGS } from "../i18n/site.ts";
import { illustrationFor } from "../lib/illustrations.ts";
import { withBase } from "../lib/paths.ts";
import Base from "./Base.astro";

interface Props {
  page: ProjectPage;
}
const { page } = Astro.props;
const lang = page.lang ?? "en";
const T = SITE_STRINGS[lang].project;
const illo = illustrationFor(page);
---
<Base page={page}>
  <PageHero page={page} illo={illo} width="wide">
    {page.releases?.map((r, i) => (
      <a class:list={["btn", i === 0 ? "btn-primary" : "btn-quiet"]} href={r.zip}>
        <Icon name="save" />
        {r.name} {r.version}
      </a>
    ))}
  </PageHero>
  <div class="wrap-wide project-body"><div class="prose-kn project-main">
    {page.sections.map((s) => (
      <section aria-labelledby={`${s.id}-heading`}>
        <h2 id={`${s.id}-heading`}>{T[s.id]}</h2>
        {s.stats && (
          <dl class="stats" data-cards="stats">
            {s.stats.map((x, i) => (
              <div class:list={["stat", i === 0 && "stat-lead"]}>
                <dt data-align="label">{x.label}</dt>
                <dd data-align="value">{x.value}</dd>
              </div>
            ))}
          </dl>
        )}
        {s.specimen && (
          <div class="specimens">
            {s.specimen.faces.map((f) => (
              <figure class="specimen">
                <figcaption>{f.name}</figcaption>
                <p lang="kn" class:list={["specimen-text", `face-${f.face}`]}>{s.specimen!.text}</p>
                <p lang="kn" class:list={["specimen-clusters", `face-${f.face}`]}>{s.specimen!.clusters}</p>
              </figure>
            ))}
          </div>
        )}
        {s.paragraphs?.map((p) => <p set:html={withBase(p)} />)}
        {s.table && <RatioTable table={s.table} lang={lang} />}
        {s.compare && <CompareTable table={s.compare} />}
        {s.items && (
          <ul class="project-list">
            {s.items.map((i) => <li set:html={withBase(i)} />)}
          </ul>
        )}
      </section>
    ))}
  </div>
  <nav class="rail" aria-labelledby="rail-heading" data-md-skip>
    <p id="rail-heading" class="rail-heading">{T.onPage}</p>
    <ol role="list">
      {page.sections.map((s) => <li><a href={`#${s.id}-heading`} data-rail={`${s.id}-heading`}>{T[s.id]}</a></li>)}
    </ol>
  </nav>
  </div>
</Base>

<script>
  // Marks the rail's link for the section being read: the last heading above the upper third of the screen.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>("[data-rail]")].map((a) => [a.dataset.rail!, a]));
  const headings = [...links.keys()].map((id) => document.getElementById(id)).filter((h): h is HTMLElement => !!h);
  let frame = 0;
  const mark = () => {
    frame = 0;
    const line = innerHeight / 3;
    let current = headings[0];
    for (const h of headings) if (h.getBoundingClientRect().top < line) current = h;
    for (const [id, a] of links) a.toggleAttribute("aria-current", id === current?.id);
  };
  if (headings.length) {
    addEventListener("scroll", () => (frame ||= requestAnimationFrame(mark)), { passive: true });
    mark();
  }
</script>

<style>
  /* Side by side, every value sits on 1 baseline and every label starts on 1 line. */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0 0.75rem;
    margin: 0 0 1rem;
  }
  .stat {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0.375rem;
    margin-bottom: 0.75rem;
    padding: 1rem 1.25rem 1.125rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--card);
  }
  .stat dd {
    grid-row: 1;
    align-self: last baseline;
    margin: 0;
    font-size: 2.25rem;
    line-height: 1.1;
    font-weight: 650;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--muted-foreground);
  }
  .stat-lead dd {
    color: var(--primary);
  }
  .stat dt {
    grid-row: 2;
    align-self: start;
    color: var(--muted-foreground);
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .stat dt:lang(kn) {
    line-height: var(--type-kn-leading);
  }
  .specimens {
    display: grid;
    gap: 0.75rem;
    margin: 0 0 1rem;
  }
  .specimen {
    margin: 0;
    padding: 1rem 1.25rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--card);
  }
  .specimen figcaption {
    color: var(--muted-foreground);
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .specimen .specimen-text {
    margin: 0.5rem 0 0;
    font-size: 1.25rem;
    line-height: var(--type-kn-leading);
  }
  .specimen .specimen-clusters {
    margin: 0.75rem 0 0;
    font-size: 1.75rem;
    line-height: var(--type-kn-leading);
    word-spacing: 0.25em;
  }
  .face-neha-sans {
    font-family: var(--type-sans);
  }
  .face-neha-serif {
    font-family: var(--type-serif);
  }
  .face-gari {
    font-family: "Gari", var(--type-sans);
    font-weight: 400;
  }
  .project-body {
    display: grid;
    gap: 2rem;
  }
  .project-main {
    min-width: 0;
    max-width: var(--prose);
  }
  .rail {
    display: none;
  }
  /* From 1024px a rail of the page's sections sits beside the prose and follows the reader. */
  @media (min-width: 64rem) {
    .project-body {
      grid-template-columns: minmax(0, var(--prose)) 13rem;
      justify-content: space-between;
    }
    .rail {
      display: block;
      position: sticky;
      top: 1.5rem;
      align-self: start;
      margin-top: 3.5rem;
      padding-left: 1rem;
      border-left: 1px solid var(--border);
      font-size: 0.875rem;
    }
    .rail-heading {
      margin-bottom: 0.5rem;
      color: var(--foreground);
      font-weight: 600;
    }
    .rail ol {
      display: grid;
      gap: 0.125rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .rail a {
      position: relative;
      display: block;
      padding: 0.3125rem 0;
      color: var(--muted-foreground);
      text-decoration: none;
      transition: color var(--duration-quick) var(--ease-standard);
    }
    .rail a::before {
      content: "";
      position: absolute;
      top: 0.375rem;
      bottom: 0.375rem;
      left: calc(-1rem - 1px);
      width: 2px;
      border-radius: 1px;
      background: var(--primary);
      transform: scaleY(0);
      transition: transform var(--duration-lift) var(--ease-settle);
    }
    .rail a:hover {
      color: var(--foreground);
    }
    .rail a[aria-current] {
      color: var(--primary);
      font-weight: 600;
    }
    .rail a[aria-current]::before {
      transform: scaleY(1);
    }
  }
  .project-list {
    display: grid;
    gap: 0.75rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
</style>
