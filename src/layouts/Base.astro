---
import "../styles/global.css";

import kannadaFont from "../fonts/noto-sans-kannada-kannada-wght-normal.woff2?url";
import latinFont from "../fonts/noto-sans-kannada-latin-wght-normal.woff2?url";

import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { HOME, PAGES, type Page } from "../content/pages.ts";
import { ORG, pagePath } from "../content/site.ts";
import { href } from "../lib/paths.ts";
import TOKENS from "../../design/tokens.json";
import { alternates, jsonLd, scriptJson } from "../lib/seo.ts";

interface Props {
  page: Page;
  /** Pages with no structured data or index entry, such as the 404 page. */
  noindex?: boolean;
}
const { page, noindex = false } = Astro.props;
// Where glass bends what is behind it: red moves pixels sideways and green up or down, both only near the edges.
const REFRACTION_MAP = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' preserveAspectRatio='none'%3E%3ClinearGradient id='x'%3E%3Cstop offset='0' stop-color='%23000'/%3E%3Cstop offset='.1' stop-color='%23800000'/%3E%3Cstop offset='.9' stop-color='%23800000'/%3E%3Cstop offset='1' stop-color='%23f00'/%3E%3C/linearGradient%3E%3ClinearGradient id='y' x2='0' y2='1'%3E%3Cstop offset='0' stop-color='%23000'/%3E%3Cstop offset='.18' stop-color='%23008000'/%3E%3Cstop offset='.82' stop-color='%23008000'/%3E%3Cstop offset='1' stop-color='%230f0'/%3E%3C/linearGradient%3E%3Crect width='100' height='100' fill='url%28%23x%29'/%3E%3Crect width='100' height='100' fill='url%28%23y%29' style='mix-blend-mode:screen'/%3E%3C/svg%3E";
const site = Astro.site ? new URL(import.meta.env.BASE_URL, Astro.site) : null;
const canonical = site ? new URL(pagePath(page.slug).slice(1), site).href : null;
const ogImage = href(`/og/${page.slug || "home"}.png`);
const ogImageUrl = site ? new URL(ogImage, site).href : null;

---
<!doctype html>
<html lang={page.lang ?? "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates(page, PAGES, site).map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {!noindex && <link rel="alternate" type="text/markdown" href={href(`${pagePath(page.slug)}index.md`)} />}
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f4f5fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16171f" media="(prefers-color-scheme: dark)" />
    <meta name="author" content="Prasad Subrahmanya" />
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={href("/favicon-32.png")} type="image/png" sizes="32x32" />
    <link rel="icon" href={href("/favicon-16.png")} type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href={href("/apple-touch-icon.png")} />
    <link rel="manifest" href={href("/site.webmanifest")} />
    <link rel="preload" href={latinFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={kannadaFont} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={ORG.name} />
    <meta property="og:title" content={page.h1} />
    <meta property="og:description" content={page.description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    {ogImageUrl && <meta property="og:image:alt" content={page.kind === "tool" ? `${page.og.from} becomes ${page.og.to}` : `${page.h1}: ${page.og.to}`} />}
    <meta name="twitter:card" content="summary_large_image" />
    {!noindex && <script type="application/ld+json" set:html={scriptJson(jsonLd(page, site, HOME))} />}
    <script is:inline>
      try {
        const t = localStorage.getItem("kannadi.theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="sr-only z-50 rounded-md bg-primary px-3 py-2 text-primary-foreground no-underline focus:not-sr-only focus:fixed focus:top-3 focus:left-3">Skip to content</a>
    <svg class="lg-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <filter id="lg-refract" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
        <feImage href={REFRACTION_MAP} preserveAspectRatio="none" result="map" />
        <feDisplacementMap in="SourceGraphic" in2="map" scale={TOKENS.glass["glass-refraction"].$value} xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>
    <SiteHeader current={page.slug} />
    <main id="main" class="w-full flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
