---
import "../styles/letters.css";

import { spellings } from "../lib/spell.ts";

interface Props {
  letter: string;
}
const { letter } = Astro.props;
const s = spellings(letter);
---
<li>
  <span class="tile-kn" lang="kn" data-align="letter">{letter}</span>
  <span class="sr-only">: type </span>
  <kbd data-align="baraha">{s.baraha}</kbd>
  <span class="sr-only">; ISO 15919 </span>
  <span class="tile-iso" data-align="iso">{s.iso}</span>
</li>
