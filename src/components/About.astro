---
import { ABOUT as ALL } from "../content/about.ts";
import type { Lang } from "../i18n/core.ts";
import { SITE_STRINGS } from "../i18n/site.ts";
import { PULL_OUT } from "../content/story.ts";
import HelpCards from "./HelpCards.astro";
import Illustration from "./Illustration.astro";
import { withBase } from "../lib/paths.ts";
import prasad160avif from "../assets/people/prasad-160.avif";
import prasad240avif from "../assets/people/prasad-240.avif";
import prasad160webp from "../assets/people/prasad-160.webp";
import prasad240webp from "../assets/people/prasad-240.webp";
import neha160avif from "../assets/people/neha-160.avif";
import neha240avif from "../assets/people/neha-240.avif";
import neha160webp from "../assets/people/neha-160.webp";
import neha240webp from "../assets/people/neha-240.webp";
import family480avif from "../assets/family/family-2023-480.avif";
import family720avif from "../assets/family/family-2023-720.avif";
import family960avif from "../assets/family/family-2023-960.avif";
import family1200avif from "../assets/family/family-2023-1200.avif";
import family480webp from "../assets/family/family-2023-480.webp";
import family720webp from "../assets/family/family-2023-720.webp";
import family960webp from "../assets/family/family-2023-960.webp";
import family1200webp from "../assets/family/family-2023-1200.webp";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ABOUT = ALL[lang];
const T = SITE_STRINGS[lang].about;
// Shown at 80 CSS pixels: 160 for 2x screens, 240 for 3x.
const PHOTOS = {
  prasad: { avif: [prasad160avif, prasad240avif], webp: [prasad160webp, prasad240webp] },
  neha: { avif: [neha160avif, neha240avif], webp: [neha160webp, neha240webp] },
};
const srcset = ([x2, x3]: { src: string }[]) => `${x2!.src} 2x, ${x3!.src} 3x`;
const widths = (files: { src: string; width: number }[]) => files.map((f) => `${f.src} ${f.width}w`).join(", ");
const FAMILY = { avif: [family480avif, family720avif, family960avif, family1200avif], webp: [family480webp, family720webp, family960webp, family1200webp] };
// Beside the text from 48rem at 18rem wide; below that, the column width up to 24rem.
const FAMILY_SIZES = "(min-width: 48rem) 18rem, min(24rem, calc(100vw - 2rem))";
---
{ABOUT.sections.map((s) => (
  <section>
    <h2>{s.heading}</h2>
    {s.paragraphs.map((p, i) => <p class:list={[i === PULL_OUT && "pull"]} set:html={withBase(p)} />)}
  </section>
))}

<section aria-labelledby="work">
  <h2 id="work">{ABOUT.work.heading}</h2>
  <ul class="work" role="list" data-cards="work">
    {ABOUT.work.items.map((w) => (
      <li>
        <Illustration name={w.illustration} />
        <span data-align="label">{w.label}</span>
      </li>
    ))}
  </ul>
</section>

<section aria-labelledby="people">
  <h2 id="people">{T.people}</h2>
  <ul class="people" role="list" data-cards="people">
    {ABOUT.people.map((p) => (
      <li>
        <picture data-md-skip>
          <source type="image/avif" srcset={srcset(PHOTOS[p.photo].avif)} />
          <img src={PHOTOS[p.photo].webp[0]!.src} srcset={srcset(PHOTOS[p.photo].webp)} alt={p.alt} width="80" height="80" loading="lazy" decoding="async" />
        </picture>
        <div>
          <b data-align="name">{p.name}</b><span class="sr-only">, </span>
          <span class="text-muted-foreground">{p.role}</span><span class="sr-only">, </span>
          <a href={p.url}>{p.site}</a>
        </div>
      </li>
    ))}
  </ul>
</section>

<section aria-labelledby="dedication">
  <h2 id="dedication">{T.dedication}</h2>
  <div class="dedication-layout">
    <div class="dedication">
      {ABOUT.dedication.map((p) => <p set:html={p} />)}
      <p class="signature">{ABOUT.signature}</p>
    </div>
    <figure class="family">
      <picture data-md-skip>
        <source type="image/avif" srcset={widths(FAMILY.avif)} sizes={FAMILY_SIZES} />
        <img src={FAMILY.webp[1]!.src} srcset={widths(FAMILY.webp)} sizes={FAMILY_SIZES} alt={ABOUT.family.alt} width={FAMILY.webp[0]!.width} height={FAMILY.webp[0]!.height} loading="lazy" decoding="async" />
      </picture>
      <figcaption>{ABOUT.family.caption}</figcaption>
    </figure>
  </div>
</section>

<section aria-labelledby="supported">
  <h2 id="supported">{T.supported}</h2>
  <p set:html={ABOUT.supporter} />
</section>

<section aria-labelledby="help">
  <h2 id="help">{T.help}</h2>
  <HelpCards items={ABOUT.help} icons={["legacy", "book", "type"]} />
</section>

<section aria-labelledby="contact">
  <h2 id="contact">{T.contact}</h2>
  <ul class="help">
    {ABOUT.contact.map((c) => <li set:html={c} />)}
  </ul>
</section>

<style>
  /* Side by side, the art sits on 1 row and every label starts on the next. */
  .work {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .work li {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0.625rem;
    margin-bottom: 0.75rem;
    padding: 0.75rem 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--card);
    font-weight: 600;
    line-height: 1.35;
  }
  @media (min-width: 48rem) {
    .work {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .work li span {
    align-self: start;
    padding-inline: 0.25rem;
  }
  .work li span:lang(kn) {
    line-height: 1.7;
  }
  .people {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .people li {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--card);
  }
  .people li div {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }
  .people picture {
    flex: none;
  }
  .people img {
    display: block;
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    background: var(--muted);
    object-fit: cover;
    box-shadow: 0 0 0 1px var(--border);
  }
  .dedication {
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--card);
  }
  .dedication > :first-child {
    margin-top: 0;
  }
  .dedication-layout {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }
  @media (min-width: 48rem) {
    .dedication-layout {
      grid-template-columns: minmax(0, 1fr) 18rem;
    }
  }
  .family {
    max-width: 24rem;
    margin: 0;
  }
  .family img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-xl);
    background: var(--muted);
    box-shadow: 0 0 0 1px var(--border);
  }
  .family figcaption {
    margin-top: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.9375rem;
  }
  /* 1 line of the story set large, between hairlines. */
  .pull {
    margin: 1.75rem 0;
    padding: 1.25rem 0;
    border-block: 1px solid var(--border);
    color: var(--foreground);
    font-size: 1.375rem;
    line-height: 1.45;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .pull:lang(kn) {
    line-height: 1.8;
  }
  .signature {
    font-weight: 600;
  }
  .help {
    display: grid;
    gap: 0.75rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
</style>
