---
import Editor from "../components/Editor.astro";
import { EDITOR_STRINGS } from "../i18n/editor.ts";
import { illustrationFor } from "../lib/illustrations.ts";
import LetterChart from "../components/LetterChart.astro";
import WordTable from "../components/WordTable.astro";
import Faq from "../components/Faq.astro";
import type { ToolPage } from "../content/pages.ts";
import { isHome } from "../content/pages.ts";
import { TAGLINE } from "../content/story.ts";
import { withBase } from "../lib/paths.ts";
import Base from "./Base.astro";
import PageHero from "../components/PageHero.astro";

interface Props {
  page: ToolPage;
}
const { page } = Astro.props;
const illo = illustrationFor(page);
---
<Base page={page}>
  <PageHero page={page} illo={illo} art="tool" tagline={isHome(page) ? TAGLINE[page.lang ?? "en"] : undefined} />
  <div class="editor-gap"></div>
  <Editor mode={page.mode} welcome={page.welcome} strings={EDITOR_STRINGS[page.lang ?? "en"]} lang={page.lang ?? "en"} />
  <div class="wrap-column prose-kn">
    <section aria-labelledby="how-heading">
      <h2 id="how-heading">{page.howTitle}</h2>
      <ol class="steps" role="list">
        {page.steps.map((s) => <li class="step reveal" data-inview><span set:html={withBase(s)} /></li>)}
      </ol>
    </section>
    {page.chart === "letters" && <LetterChart />}
    {page.chart === "words" && <WordTable />}
    <Faq faq={page.faq} lang={page.lang ?? "en"} />
  </div>
</Base>

<style>
  .editor-gap {
    height: 2rem;
  }
  @media (min-width: 48rem) {
    .editor-gap {
      height: 2.5rem;
    }
  }
  /* The steps as numbered cards: stacked on phones, side by side from 768px with their text on 1 line. */
  .steps {
    counter-reset: step;
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.75rem;
    padding: 1rem 1.125rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--card);
    line-height: 1.6;
  }
  .step:lang(kn) {
    line-height: var(--type-kn-leading);
  }
  .step::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    background: var(--accent);
    color: var(--accent-foreground);
    box-shadow: inset 0 1px 0 var(--glass-rim);
    font-size: 0.9375rem;
    font-weight: 650;
  }
  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
    .steps:has(> :nth-child(4)) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .step {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      align-items: start;
      padding: 1.125rem 1.25rem 1.25rem;
    }
  }
</style>
