---
import Icon from "../components/Icon.astro";
import Illustration from "../components/Illustration.astro";
import { HOME_COPY } from "../content/home.ts";
import { inLanguage, type HomePage, type Page } from "../content/pages.ts";
import { pagePath } from "../content/site.ts";
import { href, withBase } from "../lib/paths.ts";
import Base from "./Base.astro";

interface Props {
  page: HomePage;
}
const { page } = Astro.props;
const lang = page.lang ?? "en";
const C = HOME_COPY[lang];
const to = (slug: string) => inLanguage(slug, lang);
const url = (p: Page | undefined) => href(pagePath(p?.slug ?? ""));
const otherLang = (p: Page | undefined) => (p && (p.lang ?? "en") !== lang ? (p.lang ?? "en") : undefined);
const editor = to("editor");
---
<Base page={page}>
  <div class="home-hero mx-auto max-w-[68rem] px-4 pt-8 sm:px-6 sm:pt-14">
    <div class="home-lede">
      <h1 class="home-title">{page.h1}</h1>
      <p class="home-intro" set:html={withBase(page.intro)} />
    </div>
    <form class="paste-card" id="handoff" data-editor={url(editor)} data-failed={C.paste.failed} data-md-skip>
      <label for="handoff-text" class="paste-label">
        <Icon name="legacy" filled />
        {C.paste.label}
      </label>
      <textarea id="handoff-text" name="text" rows="4" required placeholder="PÀ£ÀßqÀ" spellcheck="false" autocapitalize="off" autocomplete="off" aria-describedby="handoff-hint"></textarea>
      <p class="paste-hint" id="handoff-hint" aria-live="polite">{C.paste.hint}</p>
      <div class="paste-actions">
        <button type="submit" class="btn btn-primary">
          <Icon name="convert" />
          {C.paste.button}
        </button>
        <a class="paste-open" href={url(editor)} lang={otherLang(editor)}>{C.paste.open}</a>
      </div>
    </form>
  </div>

  <div class="mx-auto max-w-[68rem] px-4 sm:px-6">
    <section class="home-section home-story prose-kn" aria-labelledby="why">
      <h2 id="why">{C.story.heading}</h2>
      {C.story.paragraphs.map((p) => <p set:html={withBase(p)} />)}
      <p set:html={withBase(C.story.more)} />
    </section>

    <section class="home-section" aria-labelledby="tools">
      <h2 id="tools" class="home-h2">{C.tools.heading}</h2>
      <ul class="tools" role="list">
        {C.tools.items.map((t) => {
          const target = to(t.slug);
          return (
            <li class:list={["tool", t.slug === "editor" && "tool-wide", t.slug === "ai-benchmark" && "tool-wide-lg"]}>
              <Illustration name={t.art} class="tool-illo" />
              <div class="tool-text">
                <h3 class="tool-name">
                  <Icon name={t.icon} filled />
                  <a class="tool-link" href={url(target)} lang={otherLang(target)}>{t.name}</a>
                </h3>
                <p class="tool-line">{t.text}</p>
                {t.soon && <p class="tool-soon">{C.tools.soon}</p>}
                {t.also && (
                  <ul class="tool-also" role="list" aria-label={C.tools.also}>
                    {t.also.map((s) => {
                      const p = to(s);
                      return <li><a href={url(p)} lang={otherLang(p)}>{p?.name}</a></li>;
                    })}
                  </ul>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    </section>

    <section class="home-section home-help prose-kn" aria-labelledby="help">
      <h2 id="help">{C.help.heading}</h2>
      <p set:html={withBase(C.help.intro)} />
      <ul class="help-list">
        {C.help.items.map((h) => <li set:html={withBase(h)} />)}
      </ul>
      <p>
        <a class="btn btn-primary help-cta" href={url(to("contribute"))} lang={otherLang(to("contribute"))}>
          <Icon name="people" />
          {C.help.contribute}
        </a>
      </p>
    </section>
  </div>
</Base>

<script>
  import { handOver, htmlFor, sessionStore } from "../lib/handoff.ts";

  const form = document.getElementById("handoff") as HTMLFormElement | null;
  const field = form?.elements.namedItem("text") as HTMLTextAreaElement | null;
  // The clipboard's HTML carries each run's font, which the editor needs to convert only the legacy text.
  let pasted = { html: "", plain: "" };
  field?.addEventListener("paste", (event) => {
    const data = event.clipboardData;
    pasted = { html: data?.getData("text/html") ?? "", plain: data?.getData("text/plain") ?? "" };
  });
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!field) return;
    if (handOver(sessionStore(), field.value, htmlFor(field.value, pasted))) {
      location.href = form.dataset.editor ?? "/";
    } else {
      const hint = document.getElementById("handoff-hint");
      if (hint) hint.textContent = form.dataset.failed ?? "";
    }
  });
</script>

<style>
  .home-hero {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .home-title {
    font-size: clamp(2.125rem, 1.5rem + 3vw, 3.5rem);
    line-height: 1.12;
    font-weight: 650;
    letter-spacing: var(--type-heading-tracking);
    max-width: 18ch;
  }
  .home-title:lang(kn) {
    line-height: 1.5;
  }
  .home-intro {
    margin-top: 1.25rem;
    max-width: 58ch;
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--muted-foreground);
  }
  .paste-card {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-2xl);
    background: var(--card);
    box-shadow: var(--shadow-sheet);
  }
  .paste-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }
  .paste-label :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--primary);
  }
  .paste-card textarea {
    width: 100%;
    min-height: 7rem;
    resize: vertical;
    padding: 0.75rem 1rem;
    border: 1px solid var(--input);
    border-radius: var(--radius);
    background: var(--background);
    color: var(--foreground);
    font: inherit;
    font-size: 1.125rem;
  }
  .paste-card textarea:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 1px;
  }
  .paste-hint {
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
  .paste-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  .paste-open {
    font-size: var(--type-ui);
  }
  .home-section {
    margin-top: 4.5rem;
  }
  .home-story,
  .home-help {
    max-width: 46rem;
  }
  .home-story h2,
  .home-help h2 {
    margin-top: 0;
  }
  .home-h2 {
    margin-bottom: 1.25rem;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .tools {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tool {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 7.5rem) minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem 0.625rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-2xl);
    background: var(--card);
    transition: border-color var(--duration-quick) var(--ease-standard), box-shadow var(--duration-quick) var(--ease-standard);
  }
  .tool:hover,
  .tool:focus-within {
    border-color: oklch(from var(--primary) l c h / 0.45);
    box-shadow: var(--shadow-sheet);
  }
  .tool-text {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
  }
  .tool-name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
  }
  .tool-name :global(svg) {
    width: 1.375rem;
    height: 1.375rem;
    flex: none;
    color: var(--primary);
  }
  .tool-link {
    color: var(--foreground);
    text-decoration: none;
  }
  .tool-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .tool-link:focus-visible {
    outline: none;
  }
  .tool:has(.tool-link:focus-visible) {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
  .tool-line {
    color: var(--muted-foreground);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .tool-soon {
    justify-self: start;
    margin-top: 0.125rem;
    padding: 0.125rem 0.625rem;
    border-radius: 9999px;
    background: var(--muted);
    color: var(--muted-foreground);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .tool-also {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.125rem 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }
  @media (min-width: 40rem) {
    .tools {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tool {
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      padding: 0.75rem 0.75rem 1.25rem;
    }
    .tool-text {
      padding-inline: 0.5rem;
    }
    .tool-wide {
      grid-column: span 2;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-content: center;
      padding: 1rem 1rem 1rem 1.25rem;
    }
    .tool-wide .tool-illo {
      order: 2;
    }
  }
  @media (min-width: 64rem) {
    .home-hero {
      grid-template-columns: minmax(0, 1fr) 24rem;
      gap: 3.5rem;
    }
    .tools {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .tool-wide-lg {
      grid-column: span 2;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-content: center;
      padding: 1rem 1rem 1rem 1.25rem;
    }
    .tool-wide-lg .tool-illo {
      order: 2;
    }
  }
  .help-list {
    display: grid;
    gap: 0.75rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .help-cta {
    margin-top: 0.5rem;
    text-decoration: none;
  }
</style>
