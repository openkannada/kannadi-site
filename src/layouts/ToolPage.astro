---
import Editor from "../components/Editor.astro";
import { EDITOR_STRINGS } from "../i18n/editor.ts";
import { illustrationFor } from "../lib/illustrations.ts";
import LetterChart from "../components/LetterChart.astro";
import WordTable from "../components/WordTable.astro";
import Faq from "../components/Faq.astro";
import type { ToolPage } from "../content/pages.ts";
import { isHome } from "../content/pages.ts";
import { TAGLINE } from "../content/story.ts";
import { withBase } from "../lib/paths.ts";
import Base from "./Base.astro";
import PageHero from "../components/PageHero.astro";

interface Props {
  page: ToolPage;
}
const { page } = Astro.props;
const illo = illustrationFor(page);
---
<Base page={page}>
  <PageHero page={page} illo={illo} art="tool" tagline={isHome(page) ? TAGLINE[page.lang ?? "en"] : undefined} />
  <div class="editor-gap"></div>
  <Editor mode={page.mode} welcome={page.welcome} strings={EDITOR_STRINGS[page.lang ?? "en"]} lang={page.lang ?? "en"} />
  <div class="wrap-column"><div class="prose-kn measure">
    <section aria-labelledby="how-heading">
      <h2 id="how-heading">{page.howTitle}</h2>
      <ol class="steps">
        {page.steps.map((s) => <li><span set:html={withBase(s)} /></li>)}
      </ol>
    </section>
    {page.chart === "letters" && <LetterChart />}
    {page.chart === "words" && <WordTable />}
    <Faq faq={page.faq} lang={page.lang ?? "en"} />
  </div></div>
</Base>

<style>
  .editor-gap {
    height: 2rem;
  }
  @media (min-width: 48rem) {
    .editor-gap {
      height: 2.5rem;
    }
  }
  .steps {
    counter-reset: step;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
  }
  .steps li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 9999px;
    background: var(--accent);
    color: var(--accent-foreground);
    font-size: 0.875rem;
    font-weight: 600;
  }
</style>
