---
import Editor from "../components/Editor.astro";
import LetterChart from "../components/LetterChart.astro";
import WordTable from "../components/WordTable.astro";
import type { Page } from "../content/pages.ts";
import { withBase } from "../lib/paths.ts";
import Base from "./Base.astro";

interface Props {
  page: Page;
}
const { page } = Astro.props;
---
<Base page={page}>
  <div class="mx-auto max-w-[54rem] px-4 pt-6 pb-8 sm:px-6 sm:pt-10 md:pb-10">
    <h1 class="text-[2rem] leading-[1.15] font-semibold tracking-[-0.02em] sm:text-[2.75rem]">{page.h1}</h1>
    <p class="mt-3 max-w-[62ch] text-[1.0625rem] leading-relaxed text-muted-foreground sm:text-lg" set:html={withBase(page.intro)} />
  </div>
  <Editor mode={page.mode} welcome={page.welcome} />
  <div class="prose-kn mx-auto max-w-[46rem] px-4 sm:px-6">
    <section aria-labelledby="how-heading">
      <h2 id="how-heading">{page.howTitle}</h2>
      <ol class="steps">
        {page.steps.map((s) => <li><span set:html={withBase(s)} /></li>)}
      </ol>
    </section>
    {page.chart === "letters" && <LetterChart />}
    {page.chart === "words" && <WordTable />}
    <section aria-labelledby="faq-heading">
      <h2 id="faq-heading">Questions</h2>
      <div class="faq">
        {page.faq.map((f) => (
          <details>
            <summary set:html={f.q} />
            <p set:html={withBase(f.a)} />
          </details>
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .steps {
    counter-reset: step;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
  }
  .steps li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 9999px;
    background: var(--accent);
    color: var(--accent-foreground);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .faq {
    border-top: 1px solid var(--border);
  }
  .faq details {
    border-bottom: 1px solid var(--border);
  }
  .faq summary {
    cursor: pointer;
    list-style: none;
    padding: 1rem 2rem 1rem 0;
    position: relative;
    font-weight: 600;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: "";
    position: absolute;
    right: 0.25rem;
    top: 1.45rem;
    width: 0.55rem;
    height: 0.55rem;
    border-right: 1.75px solid var(--muted-foreground);
    border-bottom: 1.75px solid var(--muted-foreground);
    transform: rotate(45deg);
    transition: transform 0.2s var(--ease-out);
  }
  .faq details[open] summary::after {
    transform: rotate(225deg);
    top: 1.7rem;
  }
  .faq details p {
    margin: 0 0 1.25rem;
    color: var(--muted-foreground);
  }
</style>
