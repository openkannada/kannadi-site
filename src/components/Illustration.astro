---
// Hero illustrations drawn from Kannada itself, in the design tokens. Each tells its tool in 1 short
// animation that runs once when it comes into view (inview.ts adds .is-in). Every animation ends on
// the rest frame, which is also what shows without script and under reduced motion.
export type IllustrationName = "convert" | "typing" | "letters" | "font" | "spell" | "scan";

interface Props {
  name: IllustrationName;
  /** For convert: the text before and after, such as a tool page's own sample. */
  from?: string;
  to?: string;
  class?: string;
}
const { name, from = "PÀ£ÀßqÀ", to = "ಕನ್ನಡ", class: className } = Astro.props;
const id = `illo-${name}`;
const kannada = (s: string) => /[ಀ-೿]/.test(s);
const typed = [
  { key: "na", letter: "ನ" },
  { key: "ma", letter: "ಮ" },
  { key: "skA", letter: "ಸ್ಕಾ" },
  { key: "ra", letter: "ರ" },
];
---
<svg class:list={["illo", `illo-${name}`, className]} viewBox="0 0 320 240" role="presentation" aria-hidden="true" focusable="false" data-inview>
  <defs>
    <radialGradient id={`${id}-t`}><stop offset="0" class="illo-stop-turmeric" /><stop offset="1" class="illo-stop-clear" /></radialGradient>
    <radialGradient id={`${id}-i`}><stop offset="0" class="illo-stop-indigo" /><stop offset="1" class="illo-stop-clear" /></radialGradient>
    <radialGradient id={`${id}-k`}><stop offset="0" class="illo-stop-kumkuma" /><stop offset="1" class="illo-stop-clear" /></radialGradient>
  </defs>
  <circle cx="250" cy="52" r="92" fill={`url(#${id}-t)`} />
  <circle cx="62" cy="190" r="96" fill={`url(#${id}-i)`} />
  <circle cx="232" cy="214" r="64" fill={`url(#${id}-k)`} />
  <rect class="illo-sheet" x="18" y="28" width="284" height="184" rx="30" />

  {name === "convert" && (
    <g class="illo-art">
      <text class:list={["illo-from", kannada(from) ? "illo-kn" : "illo-legacy"]} x="160" y="94" text-anchor="middle" lang={kannada(from) ? "kn" : undefined}>{from}</text>
      <path class="illo-rule" d="M92 116h136" />
      <text class:list={["illo-to illo-big", kannada(to) ? "illo-kn" : "illo-legacy-big"]} x="150" y="176" text-anchor="middle" lang={kannada(to) ? "kn" : undefined}>{to}</text>
      <path class="illo-tick" pathLength="1" d="M246 158l8 8 15-16" />
    </g>
  )}
  {name === "typing" && (
    <g class="illo-art">
      {typed.map((t, i) => (
        <g transform={`translate(${46 + i * 58} 58)`}>
          <g class={`illo-key-cap illo-k${i}`}>
            <rect class="illo-key" width="52" height="40" rx="11" />
            <text class="illo-latin" x="26" y="26" text-anchor="middle">{t.key}</text>
          </g>
        </g>
      ))}
      <text class="illo-kn illo-big" x="150" y="176" text-anchor="middle" lang="kn">{typed.map((t, i) => <tspan class={`illo-c${i}`}>{t.letter}</tspan>)}</text>
      <path class="illo-caret" d="M258 142v44" />
    </g>
  )}
  {name === "letters" && (
    <g class="illo-art">
      {["ಕ", "ಕಾ", "ಕಿ", "ಕೀ"].map((l, i) => (
        <g transform={`translate(${36 + i * 64} 74)`}>
          <g class={`illo-tile illo-t${i}`}>
            <rect width="56" height="92" rx="14" class="illo-tile-bg" />
            <text class="illo-kn illo-big" x="28" y="60" text-anchor="middle" lang="kn">{l}</text>
          </g>
        </g>
      ))}
    </g>
  )}
  {name === "font" && (
    <g class="illo-art">
      <text class="illo-kn illo-huge illo-part-a" x="122" y="150" text-anchor="middle" lang="kn">ನ್</text>
      <text class="illo-kn illo-huge illo-part-b" x="200" y="150" text-anchor="middle" lang="kn">ನ</text>
      <text class="illo-kn illo-huge illo-joined" x="156" y="150" text-anchor="middle" lang="kn">ನ್ನ</text>
      <path class="illo-tick" pathLength="1" d="M232 168l8 8 15-16" />
    </g>
  )}
  {name === "spell" && (
    <g class="illo-art">
      <text class="illo-kn illo-mid" x="44" y="132" lang="kn">ಕನ್ನಡ</text>
      <text class="illo-kn illo-mid illo-wrong" x="146" y="132" lang="kn">ಬಾಷೆ</text>
      <text class="illo-kn illo-mid illo-right" x="146" y="132" lang="kn">ಭಾಷೆ</text>
      <path class="illo-typo" d="M146 148h70" />
      <path class="illo-tick" pathLength="1" d="M246 112l8 8 15-16" />
    </g>
  )}
  {name === "scan" && (
    <g class="illo-art">
      {[52, 72, 92, 112].map((y, i) => <rect class="illo-ink" x="48" y={y} width={[224, 190, 210, 140][i]} height="9" rx="4.5" />)}
      <rect class="illo-beam" x="38" y="46" width="244" height="4" rx="2" />
      <text class="illo-kn illo-mid illo-read" x="160" y="182" text-anchor="middle" lang="kn">ಕನ್ನಡ ಪುಸ್ತಕ</text>
    </g>
  )}
</svg>

<style is:global>
  .illo {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .illo .illo-stop-turmeric { stop-color: var(--field-turmeric); }
  .illo .illo-stop-indigo { stop-color: var(--field-indigo); }
  .illo .illo-stop-kumkuma { stop-color: var(--field-kumkuma); }
  .illo .illo-stop-clear { stop-color: var(--field-indigo); stop-opacity: 0; }
  .illo .illo-sheet { fill: var(--card); stroke: var(--border); }
  .illo text { font-family: var(--type-sans); }
  .illo .illo-kn { fill: var(--foreground); }
  .illo .illo-big { font-size: 52px; font-weight: 650; fill: var(--primary); }
  .illo-typing .illo-big { font-size: 44px; }
  .illo .illo-huge { font-size: 80px; font-weight: 650; fill: var(--primary); }
  .illo .illo-mid { font-size: 36px; font-weight: 600; }
  .illo .illo-legacy { font-size: 32px; fill: var(--muted-foreground); letter-spacing: 0.04em; }
  .illo .illo-legacy-big { font-size: 40px; letter-spacing: 0.04em; }
  .illo-convert .illo-from.illo-kn { font-size: 32px; font-weight: 600; fill: var(--muted-foreground); }
  .illo .illo-latin { font-size: 16px; font-weight: 600; fill: var(--muted-foreground); }
  .illo .illo-key { fill: var(--muted); stroke: var(--border); }
  .illo .illo-tile-bg { fill: var(--accent); }
  .illo .illo-tile .illo-kn { fill: var(--accent-foreground); }
  .illo .illo-rule { stroke: var(--border); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 4 6; }
  .illo .illo-tick { fill: none; stroke: var(--primary); stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; }
  .illo .illo-caret { stroke: var(--primary); stroke-width: 3; stroke-linecap: round; }
  /* A likely typo, as the editor marks it: a dashed amber line. */
  .illo .illo-typo { fill: none; stroke: var(--mark-malformed-line); stroke-width: 2.5; stroke-linecap: round; stroke-dasharray: 6 5; }
  .illo .illo-ink { fill: var(--muted-foreground); opacity: 0.35; }
  .illo .illo-beam { fill: var(--primary); opacity: 0.5; }
  .illo .illo-read { fill: var(--primary); }
  /* The rest frame: what each animation ends on, and what shows without it. */
  .illo .illo-from { opacity: 0.45; }
  .illo .illo-wrong, .illo .illo-part-a, .illo .illo-part-b, .illo .illo-beam, .illo .illo-typo { opacity: 0; }

  @media (prefers-reduced-motion: no-preference) {
    /* While the script that starts the animations loads, art not yet started stays hidden, so it never shows and then replays. */
    .illo-wait .illo:not(.is-in) .illo-art { opacity: 0; }
    .illo.is-in .illo-art * {
      animation-duration: 0.9s;
      animation-timing-function: var(--ease-settle);
      animation-fill-mode: both;
    }
    /* convert: the old text dims as the new settles in, then a tick. */
    .illo-convert.is-in .illo-from { animation-name: illo-dim; animation-delay: 0.6s; }
    .illo-convert.is-in .illo-rule { animation-name: illo-fade-in; animation-delay: 0.3s; }
    .illo-convert.is-in .illo-to { animation-name: illo-settle; animation-delay: 0.9s; transform-origin: 150px 158px; }
    .illo-convert.is-in .illo-tick { animation-name: illo-draw; animation-delay: 1.6s; }
    /* typing: each key is pressed and its letter appears, cluster by cluster, then the caret blinks twice. */
    .illo-typing.is-in .illo-key-cap { animation-name: illo-press; animation-duration: 0.3s; }
    .illo-typing.is-in tspan { animation-name: illo-ink-in; animation-duration: 0.25s; }
    .illo-typing.is-in .illo-k1, .illo-typing.is-in .illo-c1 { animation-delay: 0.35s; }
    .illo-typing.is-in .illo-k2, .illo-typing.is-in .illo-c2 { animation-delay: 0.7s; }
    .illo-typing.is-in .illo-k3, .illo-typing.is-in .illo-c3 { animation-delay: 1.05s; }
    .illo-typing.is-in .illo-caret { animation-name: illo-blink; animation-duration: 0.5s; animation-iteration-count: 4; animation-delay: 1.4s; }
    /* letters: the vowel-sign forms arrive 1 by 1. */
    .illo-letters.is-in .illo-tile { animation-name: illo-settle; transform-box: fill-box; transform-origin: center; }
    .illo-letters.is-in .illo-t1 { animation-delay: 0.15s; }
    .illo-letters.is-in .illo-t2 { animation-delay: 0.3s; }
    .illo-letters.is-in .illo-t3 { animation-delay: 0.45s; }
    /* font: a consonant with its virama and the next consonant close in and become 1 conjunct. */
    .illo-font.is-in .illo-part-a { animation-name: illo-join-a; animation-duration: 1s; }
    .illo-font.is-in .illo-part-b { animation-name: illo-join-b; animation-duration: 1s; }
    .illo-font.is-in .illo-joined { animation-name: illo-fade-in; animation-delay: 0.85s; animation-duration: 0.5s; }
    .illo-font.is-in .illo-tick { animation-name: illo-draw; animation-delay: 1.3s; }
    /* spell: the likely typo is marked, then replaced. */
    .illo-spell.is-in .illo-wrong, .illo-spell.is-in .illo-typo { animation-name: illo-shown-then-gone; animation-duration: 1.6s; }
    .illo-spell.is-in .illo-right { animation-name: illo-fade-in; animation-delay: 1.3s; animation-duration: 0.5s; }
    .illo-spell.is-in .illo-tick { animation-name: illo-draw; animation-delay: 1.7s; }
    /* scan: a beam passes over the page, and the text reads out below. */
    .illo-scan.is-in .illo-beam { animation-name: illo-scan; animation-duration: 1.4s; animation-timing-function: var(--ease-standard); }
    .illo-scan.is-in .illo-read { animation-name: illo-settle; animation-delay: 1.3s; transform-origin: 160px 172px; }
  }
  @keyframes illo-fade-in { from { opacity: 0; } }
  @keyframes illo-dim { from { opacity: 1; } }
  @keyframes illo-settle { from { opacity: 0; transform: translateY(10px) scale(0.96); filter: blur(4px); } }
  @keyframes illo-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes illo-press { 50% { transform: translateY(2px); } }
  @keyframes illo-ink-in { from { fill-opacity: 0; } }
  @keyframes illo-blink { 50% { opacity: 0; } }
  @keyframes illo-join-a { from { opacity: 1; transform: translateX(-14px); } 80% { opacity: 1; transform: translateX(10px); } to { opacity: 0; transform: translateX(14px); } }
  @keyframes illo-join-b { from { opacity: 1; transform: translateX(14px); } 80% { opacity: 1; transform: translateX(-12px); } to { opacity: 0; transform: translateX(-16px); } }
  @keyframes illo-shown-then-gone { 0%, 70% { opacity: 1; } to { opacity: 0; } }
  @keyframes illo-scan { from { opacity: 0.6; transform: translateY(0); } 90% { opacity: 0.6; transform: translateY(74px); } to { opacity: 0; transform: translateY(78px); } }
</style>
