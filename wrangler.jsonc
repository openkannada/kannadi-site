{
  // The site on Cloudflare Workers with static assets. Everything the hosting needs is declared here;
  // infra/README.md lists the few settings that live in the dashboard.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openkannada",
  "account_id": "47ac3abdfba61feac39847f19ee678b1",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-16",
  // No *.workers.dev address and no preview URLs, so the site has 1 address.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The Worker sees every request: it redirects other hosts and sets noindex before launch.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "openkannada.org", "custom_domain": true },
    { "pattern": "www.openkannada.org", "custom_domain": true },
    { "pattern": "openkannada.com", "custom_domain": true },
    { "pattern": "www.openkannada.com", "custom_domain": true }
  ]
}
