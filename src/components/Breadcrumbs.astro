---
import { HOMES, isHome, type Page } from "../content/pages.ts";
import { SITE_STRINGS } from "../i18n/site.ts";
import { pagePath } from "../content/site.ts";
import { href } from "../lib/paths.ts";

interface Props {
  page: Page;
}
const { page } = Astro.props;
const lang = page.lang ?? "en";
const home = HOMES[lang];
---
{!isHome(page) && (
  <nav aria-label={SITE_STRINGS[lang].breadcrumb} class="crumbs" data-md-skip>
    <ol>
      <li><a href={href(pagePath(home.slug))}>{home.name}</a></li>
      <li aria-current="page">{page.name}</li>
    </ol>
  </nav>
)}

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0 0 0.75rem;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
  .crumbs li + li::before {
    content: "/";
    content: "/" / "";
    margin-right: 0.5rem;
    opacity: 0.6;
  }
  .crumbs a {
    color: inherit;
  }
</style>
