---
import "../styles/letters.css";

import { DIGITS, MANNERS, STRUCTURED, UNSTRUCTURED, VOWELS, YOGAVAHAS } from "../content/letters.ts";
import { spellings } from "../lib/spell.ts";
import LetterTile from "./LetterTile.astro";
---
<section aria-labelledby="vowels-heading">
  <h2 id="vowels-heading">Vowels <span lang="kn">ಸ್ವರಗಳು</span></h2>
  <ul class="tiles" role="list">{VOWELS.map((k) => <LetterTile letter={k} />)}</ul>
</section>
<section aria-labelledby="yogavaha-heading">
  <h2 id="yogavaha-heading">Yogavahas <span lang="kn">ಯೋಗವಾಹಗಳು</span></h2>
  <ul class="tiles" role="list">{YOGAVAHAS.map((k) => <LetterTile letter={k} />)}</ul>
</section>
<section aria-labelledby="structured-heading">
  <h2 id="structured-heading">Structured consonants <span lang="kn">ವರ್ಗೀಯ ವ್ಯಂಜನಗಳು</span></h2>
  <p>5 groups by where in the mouth the sound is made, each in 5 columns by how it is said.</p>
  <div class="table-scroll">
    <table class="letters">
      <thead>
        <tr><th scope="col">Group</th>{MANNERS.map((m) => <th scope="col">{m.en}<span class="manner-kn" lang="kn">{m.kn}</span></th>)}</tr>
      </thead>
      <tbody>
        {STRUCTURED.map((row) => (
          <tr>
            <th scope="row" lang="kn">{row.group}</th>
            {row.letters.map((k) => {
              const s = spellings(k);
              return <td><span class="cell-kn" lang="kn">{k}</span><span class="sr-only">: type </span><kbd>{s.baraha}</kbd><span class="sr-only">; ISO 15919 </span><span class="cell-iso">{s.iso}</span></td>;
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
<section aria-labelledby="unstructured-heading">
  <h2 id="unstructured-heading">Unstructured consonants <span lang="kn">ಅವರ್ಗೀಯ ವ್ಯಂಜನಗಳು</span></h2>
  <ul class="tiles" role="list">{UNSTRUCTURED.map((k) => <LetterTile letter={k} />)}</ul>
</section>
<section aria-labelledby="digits-heading">
  <h2 id="digits-heading">Kannada digits <span lang="kn">ಅಂಕಿಗಳು</span></h2>
  <ul class="tiles" role="list">
    {DIGITS.map((d, i) => <li><span class="tile-kn" lang="kn">{d}</span><span class="sr-only">: </span><span class="tile-iso">{i}</span></li>)}
  </ul>
</section>
