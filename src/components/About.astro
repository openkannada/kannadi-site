---
import { ABOUT as ALL } from "../content/about.ts";
import type { Lang } from "../i18n/core.ts";
import { SITE_STRINGS } from "../i18n/site.ts";
import Illustration from "./Illustration.astro";
import { withBase } from "../lib/paths.ts";
import prasad160avif from "../assets/people/prasad-160.avif";
import prasad240avif from "../assets/people/prasad-240.avif";
import prasad160webp from "../assets/people/prasad-160.webp";
import prasad240webp from "../assets/people/prasad-240.webp";
import neha160avif from "../assets/people/neha-160.avif";
import neha240avif from "../assets/people/neha-240.avif";
import neha160webp from "../assets/people/neha-160.webp";
import neha240webp from "../assets/people/neha-240.webp";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ABOUT = ALL[lang];
const T = SITE_STRINGS[lang].about;
// Shown at 80 CSS pixels: 160 for 2x screens, 240 for 3x.
const PHOTOS = {
  prasad: { avif: [prasad160avif, prasad240avif], webp: [prasad160webp, prasad240webp] },
  neha: { avif: [neha160avif, neha240avif], webp: [neha160webp, neha240webp] },
};
const srcset = ([x2, x3]: { src: string }[]) => `${x2!.src} 2x, ${x3!.src} 3x`;
---
{ABOUT.sections.map((s) => (
  <section>
    <h2>{s.heading}</h2>
    {s.paragraphs.map((p) => <p set:html={withBase(p)} />)}
  </section>
))}

<section aria-labelledby="work">
  <h2 id="work">{ABOUT.work.heading}</h2>
  <ul class="work" role="list">
    {ABOUT.work.items.map((w) => (
      <li>
        <Illustration name={w.illustration} />
        <span>{w.label}</span>
      </li>
    ))}
  </ul>
</section>

<section aria-labelledby="people">
  <h2 id="people">{T.people}</h2>
  <ul class="people" role="list">
    {ABOUT.people.map((p) => (
      <li>
        <picture>
          <source type="image/avif" srcset={srcset(PHOTOS[p.photo].avif)} />
          <img src={PHOTOS[p.photo].webp[0]!.src} srcset={srcset(PHOTOS[p.photo].webp)} alt={p.alt} width="80" height="80" loading="lazy" decoding="async" />
        </picture>
        <div>
          <b>{p.name}</b><span class="sr-only">, </span>
          <span class="text-muted-foreground">{p.role}</span><span class="sr-only">, </span>
          <a href={p.url}>{p.site}</a>
        </div>
      </li>
    ))}
  </ul>
</section>

<section aria-labelledby="dedication">
  <h2 id="dedication">{T.dedication}</h2>
  <div class="dedication">
    {ABOUT.dedication.map((p) => <p set:html={p} />)}
    <p class="signature">{ABOUT.signature}</p>
  </div>
</section>

<section aria-labelledby="supported">
  <h2 id="supported">{T.supported}</h2>
  <p set:html={ABOUT.supporter} />
</section>

<section aria-labelledby="help">
  <h2 id="help">{T.help}</h2>
  <ul class="help">
    {ABOUT.help.map((h) => <li set:html={h} />)}
  </ul>
</section>

<section aria-labelledby="contact">
  <h2 id="contact">{T.contact}</h2>
  <ul class="help">
    {ABOUT.contact.map((c) => <li set:html={c} />)}
  </ul>
</section>

<style>
  .work {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .work li {
    display: grid;
    gap: 0.5rem;
    padding: 0.75rem 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--card);
    font-weight: 600;
    line-height: 1.35;
  }
  .people {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .people li {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--card);
  }
  .people li div {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }
  .people img {
    display: block;
    flex: none;
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    background: var(--muted);
    object-fit: cover;
  }
  .dedication {
    border-left: 3px solid var(--primary);
    padding-left: 1.25rem;
  }
  .signature {
    font-weight: 600;
  }
  .help {
    display: grid;
    gap: 0.75rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
</style>
