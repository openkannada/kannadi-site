---
import AlphabetTables from "../components/AlphabetTables.astro";
import KagunitaTable from "../components/KagunitaTable.astro";
import type { ReferencePage } from "../content/pages.ts";
import { withBase } from "../lib/paths.ts";
import Base from "./Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Faq from "../components/Faq.astro";

interface Props {
  page: ReferencePage;
}
const { page } = Astro.props;
---
<Base page={page}>
  <div class="mx-auto max-w-[54rem] px-4 pt-6 pb-2 sm:px-6 sm:pt-10">
    <Breadcrumbs page={page} />
    <h1 class="text-[2rem] leading-[1.15] font-semibold tracking-[-0.02em] sm:text-[2.75rem]">{page.h1}</h1>
    <p class="mt-3 max-w-[62ch] text-[1.0625rem] leading-relaxed text-muted-foreground sm:text-lg" set:html={withBase(page.intro)} />
  </div>
  <div class="prose-kn mx-auto max-w-[54rem] px-4 sm:px-6">
    {page.table === "alphabet" && <AlphabetTables />}
    {page.table === "kagunita" && <KagunitaTable />}
    <Faq faq={page.faq} />
  </div>
</Base>
